{
  "manifest_version": 3,
  "name": "Checkmate",
  "description": "Even More Feature packed extension for Canvas.",
  "version": "7.1.0",
  "icons": {
    "16": "icon/icon-16.png",
    "32": "icon/icon-32.png",
    "48": "icon/icon-48.png",
    "128": "icon/icon-128.png"
  },
  "action": {
    "default_icon": {
      "19": "icon/icon-19.png",
      "38": "icon/icon-38.png"
    },
    "default_popup": "html/popup.html",
    "default_title": "Checkmate"
  },
  "background": {
    "scripts": ["js/background.js"],
    "service_worker": "js/background.js"
  },
  "options_page": "html/options.html",
  "content_scripts": [
    {
      "matches": ["https://*/*"],
      "js": ["css/darkmodecss.js", "js/backgrounds.js", "js/markdown.js", "js/content.js", "js/x-core.js", "js/x-grades.js", "js/x-planning.js", "js/x-widgets.js", "js/x-themes.js", "js/x-focus.js", "js/x-surfaces.js"],
      "css": ["css/content.css", "css/refined.css", "css/extras.css","css/themed.css"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["themes/*"],
      "matches": ["https://*/*"]
    }
  ],
  "permissions": ["storage", "unlimitedStorage"],
  "default_locale": "en",
  "browser_specific_settings": {
    "gecko": {
      "id": "canvasrefined@guysan.site",
      "strict_min_version": "109.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
